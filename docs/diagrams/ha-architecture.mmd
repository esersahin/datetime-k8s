graph TB
    subgraph Host["🖥️ Local Machine (Host)"]
        User["👤 User<br/>Browser"]
        HAProxy["⚖️ HAProxy LB<br/>Port 80/443/8404<br/>kind-http-lb"]
    end

    subgraph Docker["🐳 Docker Network (kind)"]
        subgraph ControlPlane["🎛️ Control Plane (HA - 3 Nodes)"]
            CP1["Control Plane 1<br/>API Server<br/>etcd 1/3"]
            CP2["Control Plane 2<br/>API Server<br/>etcd 2/3"]
            CP3["Control Plane 3<br/>API Server<br/>etcd 3/3"]
        end

        subgraph Workers["👷 Worker Nodes (3 Nodes)"]
            subgraph W1["Worker 1"]
                NGINX1["🔀 NGINX Ingress<br/>Replica 1/3<br/>hostNetwork:true"]
                Pods1["📦 App Pods"]
            end

            subgraph W2["Worker 2"]
                NGINX2["🔀 NGINX Ingress<br/>Replica 2/3<br/>hostNetwork:true"]
                Pods2["📦 App Pods"]
            end

            subgraph W3["Worker 3"]
                NGINX3["🔀 NGINX Ingress<br/>Replica 3/3<br/>hostNetwork:true"]
                Pods3["📦 App Pods"]
            end
        end

        subgraph Services["🎯 Kubernetes Services"]
            APISvc["api-service"]
            WebSvc["web-service"]
            APIGoSvc["api-go-service"]
            WebGoSvc["web-go-service"]
        end
    end

    User -->|"HTTP :80"| HAProxy
    HAProxy -->|"Round-robin<br/>Health Check"| NGINX1
    HAProxy -.->|"Round-robin<br/>Health Check"| NGINX2
    HAProxy -.->|"Round-robin<br/>Health Check"| NGINX3

    CP1 <-->|"etcd Raft<br/>consensus"| CP2
    CP2 <-->|"etcd Raft<br/>consensus"| CP3
    CP3 <-->|"etcd Raft<br/>consensus"| CP1

    NGINX1 -->|"Host: api.local"| APISvc
    NGINX2 -.->|"Host: web.local"| WebSvc
    NGINX3 -.->|"Host: api-go.local"| APIGoSvc

    APISvc --> Pods1
    WebSvc --> Pods2
    APIGoSvc --> Pods3

    style HAProxy fill:#ff9999,stroke:#cc0000,stroke-width:3px
    style CP1 fill:#99ccff,stroke:#0066cc,stroke-width:2px
    style CP2 fill:#99ccff,stroke:#0066cc,stroke-width:2px
    style CP3 fill:#99ccff,stroke:#0066cc,stroke-width:2px
    style NGINX1 fill:#99ff99,stroke:#009900,stroke-width:2px
    style NGINX2 fill:#99ff99,stroke:#009900,stroke-width:2px
    style NGINX3 fill:#99ff99,stroke:#009900,stroke-width:2px

    classDef haStyle fill:#ffcccc,stroke:#cc0000
    classDef cpStyle fill:#cce5ff,stroke:#0066cc
    classDef workerStyle fill:#ccffcc,stroke:#009900
