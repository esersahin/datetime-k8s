# ============================================
# DATETIME K8S - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Bu dosya .env için bir şablondur.
# Kullanmak için:
#   1. Bu dosyayı kopyalayın: cp .env.example .env
#   2. .env dosyasını açın ve gerçek değerleri girin
#   3. .env dosyası GIT'e commit edilmeyecektir
# ============================================

# ============================================
# C# API SECRETS
# ============================================
# Timezone (örnek: Europe/Istanbul, UTC, America/New_York)
CSHARP_TIMEZONE=Europe/Istanbul

# Log Level (örnek: debug, info, warn, error)
CSHARP_LOG_LEVEL=debug

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
CSHARP_DB_URL=postgresql://username:password@host:5432/database_name

# API Key (güvenli bir string)
CSHARP_API_KEY=your-api-key-here

# JWT Secret (güvenli bir string, en az 32 karakter önerilir)
CSHARP_JWT_SECRET=your-jwt-secret-here

# Redis URL
# Format: redis://host:port
CSHARP_REDIS_URL=redis://host:6379

# ============================================
# GO API SECRETS
# ============================================
# Timezone (örnek: Europe/Istanbul, UTC, America/New_York)
GO_TIMEZONE=UTC

# Log Level (örnek: debug, info, warn, error)
GO_LOG_LEVEL=info

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
GO_DB_URL=postgresql://username:password@host:5432/database_name

# API Key (güvenli bir string)
GO_API_KEY=your-api-key-here

# JWT Secret (güvenli bir string, en az 32 karakter önerilir)
GO_JWT_SECRET=your-jwt-secret-here

# Redis URL
# Format: redis://host:port
GO_REDIS_URL=redis://host:6380
